# Base bot configuration; never place real session keys or API secrets in Git.
BOT_NAME=BASEBOT
OWNER_NAME=Owner
OWNER_NUMBERS=6281234567890
BOT_PREFIX=.
PUBLIC_MODE=true
PAIRING_PHONE=
# Pairing code dihasilkan oleh Baileys; jangan set kode tetap/custom.
WELCOME_ENABLED=true
NEWSLETTER_NAME=
NEWSLETTER_ID=
NEWSLETTER_URL=
TIMEZONE=Asia/Jakarta
STICKER_PACK_NAME=BASEBOT
STICKER_PACK_AUTHOR=
TTS_API_KEY=
TTS_VOICE_ID=
LOG_LEVEL=info
LOG_FORMAT=pretty
# auto mengikuti TTY/NO_COLOR; opsi lain: always atau never.
LOG_COLOR=auto
BAILEYS_LOG_LEVEL=warn
SESSION_DIR=./session
TEMP_DIR=./storage/temp
LOG_DIR=./logs
PLUGINS_DIR=./plugins
PLUGIN_RELOAD=false
