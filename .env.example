# Base bot configuration; never place real session keys or API secrets in Git.
BOT_NAME=BASEBOT
OWNER_NAME=Owner
OWNER_NUMBERS=6281234567890
BOT_PREFIX=.
PUBLIC_MODE=true
PAIRING_PHONE=
WELCOME_ENABLED=true
NEWSLETTER_NAME=
NEWSLETTER_ID=
NEWSLETTER_URL=
TIMEZONE=Asia/Jakarta
STICKER_PACK_NAME=BASEBOT
STICKER_PACK_AUTHOR=
STICKER_API_ASEPHARYANA_ENABLED=false
TTS_API_KEY=
TTS_VOICE_ID=
# Soclip provider for Instagram, TikTok and YouTube.
SOCLIP_API_KEY=
DOWNLOADER_FALLBACK=true
# Optional local YouTube audio fallback (requires yt-dlp and FFmpeg).
YTDLP_ENABLED=true
YTDLP_PATH=yt-dlp
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_COLOR=auto
BAILEYS_LOG_LEVEL=warn
SESSION_DIR=./session
TEMP_DIR=./storage/temp
LOG_DIR=./logs
PLUGINS_DIR=./plugins
PLUGIN_RELOAD=false

# Auto reload plugin JavaScript tanpa restart bot.
PLUGIN_AUTO_RELOAD=true
PLUGIN_WATCH_DEBOUNCE_MS=700
