{
  "name": "basebot",
  "version": "2.0.0",
  "description": "Modular WhatsApp bot framework built on a plugin architecture.",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test tests/unit/*.test.js",
    "check": "node --check index.js && find src plugins start/lib -type f -name \"*.js\" -print0 | xargs -0 -n1 node --check"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@itsliaaa/baileys": "0.4.4",
    "@napi-rs/image": "1.16.0",
    "axios": "1.21.1",
    "fluent-ffmpeg": "2.1.3",
    "form-data": "4.0.6",
    "node-fetch": "2.7.0",
    "node-webpmux": "3.2.1",
    "pino": "10.4.0",
    "ws": "8.22.2",
    "yt-search": "2.13.1"
  },
  "overrides": {
    "minimatch": "3.1.4"
  }
}
